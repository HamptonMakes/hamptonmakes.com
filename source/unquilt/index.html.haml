;;;
"title": "Color Flood: World Challenge",
"description": "A relaxing color-flood puzzle game for iOS and Android.",
"layout": "layout"
;;;

.color-flood
  %img.color-flood-promo{src: "/images/color-flood/promo.png", alt: "Color Flood: World Challenge gameplay"}

  .color-flood-intro
    %h1 Color Flood: World Challenge
    %p.color-flood-tagline Relaxing Color Flood Puzzle
    %p
      Color Flood: World Challenge is a simple, beautiful color flood puzzle game.
      Start from the corner and flood the board by choosing colors — try to capture every cell in the fewest moves!

    .store-links
      %a.store-link{href: "https://apps.apple.com/app/id387175530"} Download on iOS
      %a.store-link{href: "https://play.google.com/store/apps/details?id=com.hamptoncatlin.unquilt"} Get it on Android

  .color-flood-strategy
    %h2 How to Play
    %ul
      %li Tap a color to flood outward from the top-left corner
      %li Match neighboring colors to grow your territory
      %li Capture the entire board in as few moves as possible
      %li Faster times and fewer moves earn higher scores
    %h2 Features
    %ul
      %li Simple, relaxing gameplay anyone can enjoy
      %li Global leaderboard — compete with players worldwide
      %li Power-ups — spend points on score multipliers
      %li Multiple color themes to customize your experience
      %li Offline mode — play without internet, scores sync when you reconnect
      %li Beautiful, clean design

  .color-flood-screenshots{aria: {label: "Color Flood gameplay screenshots"}}
    %img{src: "/images/color-flood/game.png", alt: "Flooding a colorful puzzle board"}
    %img{src: "/images/color-flood/bonuses.png", alt: "Timed score multiplier choices"}
    %img{src: "/images/color-flood/leaderboard.png", alt: "Worldwide player leaderboard"}

  %p.color-flood-policy
    %a{href: "/unquilt/policies.html"} Privacy policy
